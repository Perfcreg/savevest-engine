# Minimal test Dockerfile - just copy and test the built app
FROM node:20-alpine

WORKDIR /app

# Copy the built application and startup script
COPY build/ ./build/
COPY start.sh ./

# Set permissions for startup script
RUN chmod +x start.sh

# Set production environment
ENV NODE_ENV=production
ENV PORT=3333
ENV HOST=0.0.0.0

EXPOSE 3333

# Test if the server file exists and is executable
RUN ls -la build/bin/server.js && echo "✅ Server file found!"

# Use a simple command to test the app structure
CMD ["node", "build/bin/server.js"]