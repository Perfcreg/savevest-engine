# Test Dockerfile that uses local build
FROM node:20-alpine

WORKDIR /app

# Copy the built application
COPY build/ ./build/
COPY start.sh ./

# Install production dependencies in build directory
WORKDIR /app/build
RUN yarn install --production --frozen-lockfile

# Go back to app directory
WORKDIR /app

# Set permissions for startup script
RUN chmod +x start.sh

# Set production environment
ENV NODE_ENV=production
ENV PORT=3333
ENV HOST=0.0.0.0

EXPOSE 3333

# Use startup script
CMD ["./start.sh"]